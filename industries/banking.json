{
  "id": "banking",
  "label": "Banking",
  "version": 1,
  "proxy": "banking-mcp",
  "basePath": "/banking/mcp",
  "currency": "USD",
  "personas": {
    "ops": {
      "role": "sales_agent",
      "label": "Support & Sales",
      "app": "Unified Sales App",
      "product": "Banking Tools MCP - Support and Sales",
      "productDisplayName": "Banking Tools MCP - Support & Sales",
      "description": "Banking Support & Sales: look up customers, accounts, cards and transactions, block cards, log service requests and reverse fees (gateway limit $50). No portfolio or profitability data."
    },
    "insights": {
      "role": "loans_agent",
      "label": "Analysts",
      "app": "Unified Loans App",
      "product": "Banking Tools MCP - Analysts",
      "productDisplayName": "Banking Tools MCP - Analysts",
      "description": "Banking Analysts: dispute and delinquency metrics, segment profitability and credit-loss forecasts. Aggregates only, no individual customer records."
    },
    "admin": {
      "role": "admin",
      "label": "Admin",
      "product": "Banking Tools MCP Admin",
      "productDisplayName": "Banking Tools MCP Admin",
      "description": "Banking: every tool, no business-rule limits. Used by admins and by the ungoverned agent in the Agent Showcase."
    }
  },
  "tools": [
    {
      "name": "searchCustomers",
      "slot": "pii",
      "persona": "ops",
      "quotaPerMin": 20,
      "description": "Search bank customers by name, customer ID or email prefix. Emails are masked.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Name, customer ID or email prefix (at least 2 characters)"
          }
        },
        "required": [
          "query"
        ]
      },
      "area": "Customers"
    },
    {
      "name": "getAccountSummary",
      "slot": "lookup",
      "persona": "ops",
      "quotaPerMin": 20,
      "description": "Get a customer's profile, deposit accounts with balances, cards and open service requests.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "customerId": {
            "type": "string",
            "description": "Customer ID, e.g. CUST-2001"
          }
        },
        "required": [
          "customerId"
        ]
      },
      "area": "Accounts"
    },
    {
      "name": "listRecentTransactions",
      "slot": "lookup",
      "persona": "ops",
      "quotaPerMin": 20,
      "description": "List a customer's most recent card and account transactions, including fees and disputed charges.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "customerId": {
            "type": "string",
            "description": "Customer ID, e.g. CUST-2001"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "description": "Max transactions to return (default 10)"
          }
        },
        "required": [
          "customerId"
        ]
      },
      "area": "Accounts"
    },
    {
      "name": "getCardStatus",
      "slot": "lookup",
      "persona": "ops",
      "quotaPerMin": 20,
      "description": "Get a card's status, block reason, credit limit and available credit.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "cardId": {
            "type": "string",
            "description": "Card ID, e.g. CARD-4417"
          }
        },
        "required": [
          "cardId"
        ]
      },
      "area": "Cards"
    },
    {
      "name": "blockCard",
      "slot": "write",
      "persona": "ops",
      "quotaPerMin": 10,
      "description": "Block a card, for example when it is lost, stolen or has a suspicious charge.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "cardId": {
            "type": "string",
            "description": "Card ID, e.g. CARD-4417"
          },
          "reason": {
            "type": "string",
            "enum": [
              "Lost",
              "Stolen",
              "Suspicious activity",
              "Customer request"
            ],
            "description": "Why the card is blocked"
          }
        },
        "required": [
          "cardId",
          "reason"
        ]
      },
      "area": "Cards"
    },
    {
      "name": "createServiceRequest",
      "slot": "write",
      "persona": "ops",
      "quotaPerMin": 10,
      "description": "Open a service request for a customer, e.g. a dispute follow-up or a replacement card.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "customerId": {
            "type": "string",
            "description": "Customer ID, e.g. CUST-2001"
          },
          "subject": {
            "type": "string",
            "description": "Short summary of the request"
          },
          "priority": {
            "type": "string",
            "enum": [
              "Low",
              "Medium",
              "High"
            ],
            "description": "Default Medium"
          }
        },
        "required": [
          "customerId",
          "subject"
        ]
      },
      "area": "Service"
    },
    {
      "name": "reverseFee",
      "slot": "money",
      "persona": "ops",
      "quotaPerMin": 5,
      "description": "Reverse (refund) all or part of a fee charged to the customer. Reversals over $50 need supervisor approval.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "feeId": {
            "type": "string",
            "description": "Fee ID from the transaction list, e.g. FEE-7001"
          },
          "amount": {
            "type": "number",
            "description": "Amount to reverse in USD"
          },
          "reason": {
            "type": "string",
            "description": "Reason for the reversal"
          }
        },
        "required": [
          "feeId",
          "amount"
        ]
      },
      "area": "Fees"
    },
    {
      "name": "getPaymentStatus",
      "slot": "lookup",
      "persona": "ops",
      "area": "Payments",
      "quotaPerMin": 20,
      "description": "Get a payment or transfer: status, amount, payee and schedule.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "paymentId": {
            "type": "string",
            "description": "Payment ID, e.g. PAY-8801"
          }
        },
        "required": [
          "paymentId"
        ]
      }
    },
    {
      "name": "cancelScheduledPayment",
      "slot": "write",
      "persona": "ops",
      "area": "Payments",
      "quotaPerMin": 10,
      "description": "Cancel a scheduled (not yet sent) payment.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "paymentId": {
            "type": "string",
            "description": "Payment ID, e.g. PAY-8802"
          },
          "reason": {
            "type": "string",
            "description": "Why the payment is cancelled"
          }
        },
        "required": [
          "paymentId"
        ]
      }
    },
    {
      "name": "getLoanDetails",
      "slot": "lookup",
      "persona": "ops",
      "area": "Loans",
      "quotaPerMin": 20,
      "description": "Get a customer's loan: balance, rate, next payment and status.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "loanId": {
            "type": "string",
            "description": "Loan ID, e.g. LN-5501"
          }
        },
        "required": [
          "loanId"
        ]
      }
    },
    {
      "name": "getLoanPayoffQuote",
      "slot": "lookup",
      "persona": "ops",
      "area": "Loans",
      "quotaPerMin": 20,
      "description": "Quote the amount needed to pay off a loan on a given date.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "loanId": {
            "type": "string",
            "description": "Loan ID, e.g. LN-5501"
          },
          "payoffDate": {
            "type": "string",
            "description": "YYYY-MM-DD, default 2026-10-01"
          }
        },
        "required": [
          "loanId"
        ]
      }
    },
    {
      "name": "listFraudAlerts",
      "slot": "lookup",
      "persona": "ops",
      "area": "Fraud",
      "quotaPerMin": 20,
      "description": "List fraud alerts on a customer's cards and accounts.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "customerId": {
            "type": "string",
            "description": "Customer ID, e.g. CUST-2001"
          }
        },
        "required": [
          "customerId"
        ]
      }
    },
    {
      "name": "resolveFraudAlert",
      "slot": "write",
      "persona": "ops",
      "area": "Fraud",
      "quotaPerMin": 10,
      "description": "Mark a fraud alert as confirmed fraud or as a genuine customer transaction.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "alertId": {
            "type": "string",
            "description": "Alert ID, e.g. FA-3301"
          },
          "resolution": {
            "type": "string",
            "enum": [
              "Confirmed fraud",
              "Genuine transaction"
            ],
            "description": "Outcome after talking to the customer"
          }
        },
        "required": [
          "alertId",
          "resolution"
        ]
      }
    },
    {
      "name": "getDisputeMetrics",
      "slot": "metrics",
      "persona": "insights",
      "quotaPerMin": 20,
      "description": "Card dispute volumes, top merchant categories and average resolution time, compared with the previous period.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "period": {
            "type": "string",
            "enum": [
              "last_30d",
              "last_90d"
            ],
            "description": "Default last_30d"
          }
        }
      },
      "area": "Risk"
    },
    {
      "name": "getDelinquencyTrends",
      "slot": "metrics",
      "persona": "insights",
      "quotaPerMin": 20,
      "description": "Monthly 30+ and 90+ days-past-due rates for cards and personal loans.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "months": {
            "type": "integer",
            "minimum": 3,
            "maximum": 12,
            "description": "Months of history (default 6)"
          }
        }
      },
      "area": "Risk"
    },
    {
      "name": "getSegmentProfitability",
      "slot": "confidential",
      "persona": "insights",
      "quotaPerMin": 20,
      "description": "Confidential: revenue, cost to serve, credit losses and margin by customer segment.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "segment": {
            "type": "string",
            "enum": [
              "Mass",
              "Affluent",
              "Premier",
              "Small Business"
            ],
            "description": "Omit for all segments"
          }
        }
      },
      "area": "Profitability"
    },
    {
      "name": "getDepositTrends",
      "slot": "metrics",
      "persona": "insights",
      "area": "Deposits",
      "quotaPerMin": 20,
      "description": "Monthly deposit balances and net flows by product (checking, savings, term deposits).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "months": {
            "type": "integer",
            "minimum": 3,
            "maximum": 12,
            "description": "Months of history (default 6)"
          }
        }
      }
    },
    {
      "name": "getLoanPortfolioSummary",
      "slot": "metrics",
      "persona": "insights",
      "area": "Loans",
      "quotaPerMin": 20,
      "description": "Loan book by product: balances, average rate, new originations and prepayments.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "product": {
            "type": "string",
            "enum": [
              "Auto",
              "Mortgage",
              "Personal",
              "Small Business"
            ],
            "description": "Omit for all products"
          }
        }
      }
    },
    {
      "name": "getChannelUsage",
      "slot": "metrics",
      "persona": "insights",
      "area": "Channels",
      "quotaPerMin": 20,
      "description": "Share of transactions and service contacts by channel (mobile, web, branch, contact center).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "period": {
            "type": "string",
            "enum": [
              "last_30d",
              "last_90d"
            ],
            "description": "Default last_30d"
          }
        }
      }
    },
    {
      "name": "getFraudLossMetrics",
      "slot": "metrics",
      "persona": "insights",
      "area": "Fraud",
      "quotaPerMin": 20,
      "description": "Fraud alerts, confirmed fraud rate and fraud losses by channel, vs the previous period.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "period": {
            "type": "string",
            "enum": [
              "last_30d",
              "last_90d"
            ],
            "description": "Default last_30d"
          }
        }
      }
    },
    {
      "name": "runCreditLossForecast",
      "slot": "forecast",
      "persona": "insights",
      "quotaPerMin": 2,
      "description": "Compute-heavy: forecast monthly credit losses for the card portfolio.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "horizonMonths": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12,
            "description": "Months to forecast (default 3)"
          }
        }
      },
      "area": "Risk"
    }
  ],
  "limit": {
    "tool": "reverseFee",
    "argument": "amount",
    "max": 50,
    "persona": "ops",
    "code": "FEE_REVERSAL_LIMIT",
    "message": "Fee reversals over $50 need supervisor approval."
  },
  "story": {
    "customerId": "CUST-2001",
    "customerName": "Jane Doe",
    "cardId": "CARD-4417",
    "smallFeeId": "FEE-7001",
    "smallFeeAmount": 30,
    "largeFeeId": "FEE-7002",
    "largeFeeAmount": 120,
    "summary": "Jane Doe's credit card was blocked after a disputed $249.99 charge that raised fraud alert FA-3301. A $30 late fee reversal is within policy; waiving the $120 annual fee needs approval. She also has a car loan (LN-5501) and a scheduled card payment (PAY-8802)."
  },
