<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ExtractVariables continueOnError="true" enabled="true" name="EV-ModelResponse">
  <DisplayName>EV-ModelResponse</DisplayName>
  <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
  <JSONPayload>
    <!--
      MUST NOT be named "model". With <VariablePrefix>flow</VariablePrefix> that wrote to
      flow.model and overwrote the REQUESTED model with the provider's reported modelVersion
      part-way through the response flow.

      That silently broke the LLM token quota on the Claude path. Vertex reports Anthropic
      models with a hyphen instead of the "@" revision separator, so a request for
      "claude-haiku-5-5" comes back as modelVersion "claude-haiku-5-5".
      LTQ-TokenCount resolves its LLMModelSource from {flow.model}, so it looked up a model
      that appears in no API product operationConfig and failed with
      keymanagement.service.InvalidAPICallAsNoApiProductMatchFound. Because that policy is
      continueOnError="true" the fault was swallowed, the counter never incremented, and the
      100 tok/min quota never tripped no matter how many calls were made.

      Gemini masked the bug: its modelVersion equals the requested id, so the overwrite was a
      no-op there. Nothing reads this value (x-gateway-model and dc_model_name both use
      flow.target_model, and CalculateCost.js prefers it too), so it is kept only as a
      diagnostic under a non-colliding name.
    -->
    <Variable name="responseModelVersion">
      <JSONPath>$.modelVersion</JSONPath>
    </Variable>
    <Variable name="promptTokenCount">
      <JSONPath>$.usageMetadata.promptTokenCount</JSONPath>
    </Variable>
    <Variable name="candidatesTokenCount">
      <JSONPath>$.usageMetadata.candidatesTokenCount</JSONPath>
    </Variable>
    <Variable name="totalTokenCount">
      <JSONPath>$.usageMetadata.totalTokenCount</JSONPath>
    </Variable>
    <!-- Reasoning models report thinking tokens separately from candidatesTokenCount, but
         Vertex bills them at the output rate. Without this, a gemini-3.8-flash call that
         consumed 92 tokens was costed as 8. -->
    <Variable name="thoughtsTokenCount">
      <JSONPath>$.usageMetadata.thoughtsTokenCount</JSONPath>
    </Variable>
    <Variable name="claudePromptTokens">
      <JSONPath>$.usage.input_tokens</JSONPath>
    </Variable>
    <Variable name="claudeCandidatesTokens">
      <JSONPath>$.usage.output_tokens</JSONPath>
    </Variable>
    <!-- Response body text, captured for the Full Audit Logs view.
         Gemini shape first, Anthropic shape as fallback; whichever does not
         match simply stays unresolved. -->
    <Variable name="responseText">
      <JSONPath>$.candidates[0].content.parts[0].text</JSONPath>
    </Variable>
    <Variable name="claudeResponseText">
      <JSONPath>$.content[0].text</JSONPath>
    </Variable>
  </JSONPayload>
  <Source clearPayload="false">response</Source>
  <VariablePrefix>flow</VariablePrefix>
</ExtractVariables>
