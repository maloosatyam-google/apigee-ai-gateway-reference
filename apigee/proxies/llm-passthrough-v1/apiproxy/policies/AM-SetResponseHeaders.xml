<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<AssignMessage async="false" continueOnError="true" enabled="true" name="AM-SetResponseHeaders">
  <DisplayName>AM-SetResponseHeaders</DisplayName>
  <Set>
    <Headers>
      <Header name="x-gateway-model">{flow.target_model}</Header>
      <Header name="x-gateway-provider">google</Header>
      <Header name="x-gateway-mode">passthrough</Header>
      <Header name="x-gateway-cost-usd">{flow.tx_cost_usd}</Header>
      <Header name="x-gateway-cost-source">{flow.cost_source}</Header>
      <Header name="x-gateway-currency">USD</Header>
      <Header name="x-gateway-prompt-tokens">{flow.promptTokenCount}</Header>
      <Header name="x-gateway-completion-tokens">{flow.candidatesTokenCount}</Header>
      <Header name="x-gateway-total-tokens">{flow.totalTokenCount}</Header>
    </Headers>
  </Set>
  <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
  <AssignTo createNew="false" transport="http" type="response"/>
</AssignMessage>
