<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<APIProxy revision="1" name="ai-gateway-v1">
  <DisplayName>AI Gateway (Model-Agnostic with Auto-Routing)</DisplayName>
  <Description>Apigee Model-Agnostic AI Gateway with Multi-Provider Auto-Routing, Model Armor Upfront, Token Identity, Cost Calculation, and Budget Governance</Description>
  <BasePaths>/ai/v1</BasePaths>
  <Policies>
    <Policy>AM-InitCacheStatus</Policy>
    <Policy>AM-PrepClaudeDirect</Policy>
    <Policy>AM-PrepGeminiDirect</Policy>
    <Policy>AM-PrepRouterRequest</Policy>
    <Policy>AM-RemoveAuthorization</Policy>
    <Policy>AM-ResolveGuardrailToggles</Policy>
    <Policy>AM-RouteClaudeTarget</Policy>
    <Policy>AM-RouteGeminiTarget</Policy>
    <Policy>AM-SetCacheHitExpected</Policy>
    <Policy>AM-SetCacheMiss</Policy>
    <Policy>AM-SetResponseHeaders</Policy>
    <Policy>AM-SetUserIdentity</Policy>
    <Policy>CORS-Headers</Policy>
    <Policy>DC-FaultAnalytics</Policy>
    <Policy>DC-ModelAnalytics</Policy>
    <Policy>DJWT-ExtractUserIdentity</Policy>
    <Policy>EV-ExtractBearerToken</Policy>
    <Policy>EV-ModelResponse</Policy>
    <Policy>EV-RequestDetails</Policy>
    <Policy>JS-AuditBudgetAccounting</Policy>
    <Policy>JS-TokenQuotaThreshold</Policy>
    <Policy>JS-AutoRouting</Policy>
    <Policy>JS-CalculateCost</Policy>
    <Policy>JS-ClaudeRequestPrep</Policy>
    <Policy>JS-ExtractPromptAndModel</Policy>
    <Policy>JS-FormatClaudeResponse</Policy>
    <Policy>KVM-GetModelRates</Policy>
    <Policy>KVM-GetRouterCredentials</Policy>
    <Policy>LTQ-TokenCount</Policy>
    <Policy>LTQ-TokenEnforce</Policy>
    <Policy>ML-CloudLogging</Policy>
    <Policy>MLC-EnforceMonetizationLimits</Policy>
    <Policy>OAS-ValidateRequest</Policy>
    <Policy>QC-DeductBudget</Policy>
    <Policy>QC-EnforceBudgetLimit</Policy>
    <Policy>RF-BudgetExceeded</Policy>
    <Policy>RF-StreamingNotSupported</Policy>
    <Policy>RF-MissingUserEmail</Policy>
    <Policy>SC-ModelRouter</Policy>
    <Policy>SCL-Semantic-Cache-Lookup</Policy>
    <Policy>SCP-Semantic-Cache-Populate</Policy>
    <Policy>SMR-SanitizeModelResponse</Policy>
    <Policy>SUP-UserPrompt</Policy>
    <Policy>VA-VerifyAPIKey</Policy>
  </Policies>
  <Resources>
    <Resource>jsc://AuditBudgetAccounting.js</Resource>
    <Resource>jsc://AutoRouting.js</Resource>
    <Resource>jsc://CalculateCost.js</Resource>
    <Resource>jsc://ClaudeRequestPrep.js</Resource>
    <Resource>jsc://ExtractPromptAndModel.js</Resource>
    <Resource>jsc://FormatClaudeResponse.js</Resource>
    <Resource>jsc://TokenQuotaThreshold.js</Resource>
    <Resource>oas://openapi.yaml</Resource>
  </Resources>
  <ProxyEndpoints>
    <ProxyEndpoint>default</ProxyEndpoint>
  </ProxyEndpoints>
  <TargetEndpoints>
    <TargetEndpoint>gemini-vertex-target</TargetEndpoint>
    <TargetEndpoint>claude-vertex-target</TargetEndpoint>
  </TargetEndpoints>
</APIProxy>
