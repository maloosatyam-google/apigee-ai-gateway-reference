<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ProxyEndpoint name="default">
  <HTTPProxyConnection>
    <BasePath>/customer-service/v1</BasePath>
  </HTTPProxyConnection>
  <PreFlow name="PreFlow">
    <Request>
      <Step>
        <Name>CORS-Allow</Name>
      </Step>
      <Step>
        <Name>KVM-GetConfig</Name>
        <Condition>request.verb != "OPTIONS"</Condition>
      </Step>
      <Step>
        <Name>JS-CheckCaller</Name>
        <Condition>request.verb != "OPTIONS"</Condition>
      </Step>
      <Step>
        <Name>RF-NotInternal</Name>
        <Condition>caller.blocked = "true"</Condition>
      </Step>
      <Step>
        <Name>SA-Protect</Name>
        <Condition>request.verb != "OPTIONS"</Condition>
      </Step>
    </Request>
    <Response/>
  </PreFlow>
  <Flows>
    <Flow name="searchCustomers">
      <Request>
        <Step>
          <Name>OAS-ValidateRequest</Name>
        </Step>
      </Request>
      <Response/>
      <Condition>(proxy.pathsuffix MatchesPath "/customers") and (request.verb = "GET")</Condition>
    </Flow>
    <Flow name="listCustomerOrders">
      <Request>
        <Step>
          <Name>OAS-ValidateRequest</Name>
        </Step>
      </Request>
      <Response/>
      <Condition>(proxy.pathsuffix MatchesPath "/customers/*/orders") and (request.verb = "GET")</Condition>
    </Flow>
    <Flow name="getCustomer">
      <Request>
        <Step>
          <Name>OAS-ValidateRequest</Name>
        </Step>
      </Request>
      <Response/>
      <Condition>(proxy.pathsuffix MatchesPath "/customers/*") and (request.verb = "GET")</Condition>
    </Flow>
    <Flow name="getOrderStatus">
      <Request>
        <Step>
          <Name>OAS-ValidateRequest</Name>
        </Step>
      </Request>
      <Response/>
      <Condition>(proxy.pathsuffix MatchesPath "/orders/*") and (request.verb = "GET")</Condition>
    </Flow>
    <Flow name="getProductPrice">
      <Request>
        <Step>
          <Name>OAS-ValidateRequest</Name>
        </Step>
      </Request>
      <Response/>
      <Condition>(proxy.pathsuffix MatchesPath "/products/*/price") and (request.verb = "GET")</Condition>
    </Flow>
    <Flow name="createSupportCase">
      <Request>
        <Step>
          <Name>OAS-ValidateRequest</Name>
        </Step>
      </Request>
      <Response/>
      <Condition>(proxy.pathsuffix MatchesPath "/cases") and (request.verb = "POST")</Condition>
    </Flow>
    <Flow name="issueRefund">
      <Request>
        <Step>
          <Name>OAS-ValidateRequest</Name>
        </Step>
<Step>
  <Name>KVM-GetRefundLimit</Name>
</Step>
<Step>
  <Name>AE-CallerKey</Name>
</Step>
<Step>
  <Name>JS-CheckRefundLimit</Name>
</Step>
<Step>
  <Name>RF-RefundLimit</Name>
  <Condition>refund.overLimit = "true"</Condition>
</Step>
      </Request>
      <Response/>
      <Condition>(proxy.pathsuffix MatchesPath "/orders/*/refunds") and (request.verb = "POST")</Condition>
    </Flow>
    <Flow name="NotFound">
      <Request>
        <Step>
          <Name>RF-NotFound</Name>
        </Step>
      </Request>
      <Response/>
    </Flow>
  </Flows>
  <PostClientFlow>
    <Response>
      <Step>
        <Name>ML-CloudLogging</Name>
      </Step>
    </Response>
  </PostClientFlow>
  <RouteRule name="default">
    <TargetEndpoint>default</TargetEndpoint>
  </RouteRule>
</ProxyEndpoint>
