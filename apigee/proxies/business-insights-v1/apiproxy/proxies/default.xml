<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ProxyEndpoint name="default">
  <HTTPProxyConnection>
    <BasePath>/business-insights/v1</BasePath>
  </HTTPProxyConnection>
  <PreFlow name="PreFlow">
    <Request>
      <Step>
        <Name>CORS-Allow</Name>
      </Step>
      <Step>
        <Name>KVM-GetConfig</Name>
        <Condition>request.verb != "OPTIONS"</Condition>
      </Step>
      <Step>
        <Name>JS-CheckCaller</Name>
        <Condition>request.verb != "OPTIONS"</Condition>
      </Step>
      <Step>
        <Name>RF-NotInternal</Name>
        <Condition>caller.blocked = "true"</Condition>
      </Step>
      <Step>
        <Name>SA-Protect</Name>
        <Condition>request.verb != "OPTIONS"</Condition>
      </Step>
    </Request>
    <Response/>
  </PreFlow>
  <Flows>
    <Flow name="getRevenueTrends">
      <Request>
        <Step>
          <Name>OAS-ValidateRequest</Name>
        </Step>
      </Request>
      <Response/>
      <Condition>(proxy.pathsuffix MatchesPath "/insights/revenue") and (request.verb = "GET")</Condition>
    </Flow>
    <Flow name="getSupportMetrics">
      <Request>
        <Step>
          <Name>OAS-ValidateRequest</Name>
        </Step>
      </Request>
      <Response/>
      <Condition>(proxy.pathsuffix MatchesPath "/insights/support") and (request.verb = "GET")</Condition>
    </Flow>
    <Flow name="getChurnRisk">
      <Request>
        <Step>
          <Name>OAS-ValidateRequest</Name>
        </Step>
      </Request>
      <Response/>
      <Condition>(proxy.pathsuffix MatchesPath "/insights/churn") and (request.verb = "GET")</Condition>
    </Flow>
    <Flow name="getProductMargins">
      <Request>
        <Step>
          <Name>OAS-ValidateRequest</Name>
        </Step>
      </Request>
      <Response/>
      <Condition>(proxy.pathsuffix MatchesPath "/insights/products/*/margin") and (request.verb = "GET")</Condition>
    </Flow>
    <Flow name="runForecast">
      <Request>
        <Step>
          <Name>OAS-ValidateRequest</Name>
        </Step>
      </Request>
      <Response/>
      <Condition>(proxy.pathsuffix MatchesPath "/insights/forecast") and (request.verb = "POST")</Condition>
    </Flow>
    <Flow name="NotFound">
      <Request>
        <Step>
          <Name>RF-NotFound</Name>
        </Step>
      </Request>
      <Response/>
    </Flow>
  </Flows>
  <PostClientFlow>
    <Response>
      <Step>
        <Name>ML-CloudLogging</Name>
      </Step>
    </Response>
  </PostClientFlow>
  <RouteRule name="default">
    <TargetEndpoint>default</TargetEndpoint>
  </RouteRule>
</ProxyEndpoint>
