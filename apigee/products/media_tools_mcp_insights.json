{
  "name": "Media Tools MCP - Audience Analysts",
  "displayName": "Media Tools MCP - Audience Analysts",
  "description": "Media Audience Analysts: churn, viewership, title performance, ad revenue, streaming quality and plan-mix metrics, content margins and subscriber forecasts. Aggregates only, no individual subscriber records.",
  "approvalType": "auto",
  "attributes": [
    {
      "name": "access",
      "value": "private"
    },
    {
      "name": "industry",
      "value": "media"
    },
    {
      "name": "persona",
      "value": "loans_agent"
    }
  ],
  "environments": [
    "dev",
    "prod"
  ],
