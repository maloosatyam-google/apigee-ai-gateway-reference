{
  "name": "Manufacturing Tools MCP - Supply Chain",
  "displayName": "Manufacturing Tools MCP - Supply Chain",
  "description": "Manufacturing Supply Chain analysts: supplier delivery, defect rates, warranty cost, parts inventory, dealer fill rates and plant throughput, plant margins and parts demand forecasts. Aggregates only, no individual dealer contact records.",
