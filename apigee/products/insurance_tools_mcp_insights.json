{
  "name": "Insurance Tools MCP - Underwriting",
  "displayName": "Insurance Tools MCP - Underwriting",
  "description": "Insurance Underwriting: claims frequency, loss ratio, retention, catastrophe exposure, claims cycle-time and fraud-referral metrics, underwriting profitability and loss reserve forecasts. Aggregates only, no individual policyholder records.",
