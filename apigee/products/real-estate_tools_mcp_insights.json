{
  "name": "Real Estate Tools MCP - Portfolio Analysts",
  "displayName": "Real Estate Tools MCP - Portfolio Analysts",
  "description": "Real Estate Portfolio Analysts: sales velocity, absorption, occupancy, rent roll, collections and maintenance metrics, project margins and demand forecasts. Aggregates only, no individual buyer or tenant records.",
