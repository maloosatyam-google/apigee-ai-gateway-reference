{
  "name": "Energy Tools MCP - Asset Analysts",
  "displayName": "Energy Tools MCP - Asset Analysts",
  "description": "Energy Asset Analysts: reliability (SAIDI/SAIFI), consumption, asset health, arrears, clean-energy uptake and meter-read accuracy metrics, segment margin and load forecasts. Aggregates only, no individual customer records.",
  "approvalType": "auto",
  "attributes": [
    {
      "name": "access",
      "value": "private"
    },
    {
      "name": "industry",
      "value": "energy"
    },
    {
      "name": "persona",
      "value": "loans_agent"
    }
  ],
  "environments": [
    "dev",
    "prod"
  ],
