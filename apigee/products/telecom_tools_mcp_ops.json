  "attributes": [
    {
      "name": "access",
      "value": "private"
    },
    {
      "name": "industry",
      "value": "telecom"
    },
    {
      "name": "persona",
      "value": "sales_agent"
    }
  ],
  "environments": [
    "dev",
    "prod"
  ],
