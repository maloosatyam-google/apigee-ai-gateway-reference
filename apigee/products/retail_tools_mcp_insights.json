        "quota": {
          "limit": "20",
          "interval": "1",
          "timeUnit": "minute"
        }
      },
      {
        "apiSource": "retail-mcp",
        "operations": [
          {
            "operation": "tools/call/getCategoryMarginReport"
          }
        ],
        "quota": {
          "limit": "20",
          "interval": "1",
          "timeUnit": "minute"
        }
      },
      {
        "apiSource": "retail-mcp",
        "operations": [
          {
            "operation": "tools/call/runHolidayDemandForecast"
          }
