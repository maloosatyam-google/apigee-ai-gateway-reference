{
  "name": "Retail Tools MCP - Merchandising",
  "displayName": "Retail Tools MCP - Merchandising",
  "description": "Retail Merchandising: category sales, returns, stock health, loyalty, fulfilment and markdown metrics, category margins and holiday demand forecasts. Aggregates only, no individual shopper records.",
  "approvalType": "auto",
  "attributes": [
    {
      "name": "access",
      "value": "private"
    },
    {
      "name": "industry",
      "value": "retail"
    },
    {
      "name": "persona",
      "value": "loans_agent"
    }
  ],
  "environments": [
    "dev",
    "prod"
  ],
  "payloadOperationGroup": {
    "operationConfigs": [
      {
        "apiSource": "retail-mcp",
        "operations": [
          {
            "operation": "tools/list"
          }
        ],
        "quota": {
          "limit": "30",
          "interval": "1",
          "timeUnit": "minute"
        }
      },
      {
        "apiSource": "retail-mcp",
        "operations": [
          {
            "operation": "tools/call/getCategorySalesTrends"
          }
        ],
        "quota": {
          "limit": "20",
          "interval": "1",
          "timeUnit": "minute"
        }
      },
      {
        "apiSource": "retail-mcp",
        "operations": [
          {
            "operation": "tools/call/getReturnRateMetrics"
          }
        ],
        "quota": {
          "limit": "20",
          "interval": "1",
          "timeUnit": "minute"
        }
      },
      {
        "apiSource": "retail-mcp",
        "operations": [
          {
            "operation": "tools/call/getStockHealthSummary"
          }
        ],
        "quota": {
          "limit": "20",
          "interval": "1",
          "timeUnit": "minute"
        }
      },
      {
        "apiSource": "retail-mcp",
        "operations": [
          {
            "operation": "tools/call/getLoyaltyProgramMetrics"
          }
        ],
        "quota": {
          "limit": "20",
          "interval": "1",
          "timeUnit": "minute"
        }
      },
      {
        "apiSource": "retail-mcp",
        "operations": [
          {
            "operation": "tools/call/getOmnichannelFulfilment"
          }
        ],
        "quota": {
          "limit": "20",
          "interval": "1",
          "timeUnit": "minute"
        }
      },
      {
        "apiSource": "retail-mcp",
        "operations": [
          {
            "operation": "tools/call/getMarkdownPerformance"
          }
