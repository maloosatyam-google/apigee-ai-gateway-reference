    {
      "name": "access",
      "value": "private"
    },
    {
      "name": "industry",
      "value": "healthcare"
    },
    {
      "name": "persona",
      "value": "sales_agent"
    }
  ],
  "environments": [
    "dev",
    "prod"
  ],
