{
  "id": "education",
  "label": "Education",
  "version": 1,
  "proxy": "education-mcp",
  "basePath": "/education/mcp",
  "currency": "USD",
  "personas": {
    "ops": {
      "role": "sales_agent",
      "label": "Student Services",
      "app": "Unified Sales App",
      "product": "Education Tools MCP - Student Services",
      "productDisplayName": "Education Tools MCP - Student Services",
      "description": "Education Student & Admissions Services: look up learners, enrolments, assignments, invoices, certificates and applications; enrol and withdraw, extend deadlines, open tickets and refund invoices (gateway limit $50). No programme finance or cohort analytics."
    },
    "insights": {
      "role": "loans_agent",
      "label": "Academic Analysts",
      "app": "Unified Loans App",
      "product": "Education Tools MCP - Academic Analysts",
      "productDisplayName": "Education Tools MCP - Academic Analysts",
      "description": "Education Academic & Research Analysts: enrolment, completion, retention, admissions, engagement and assessment-integrity metrics, programme profitability and enrolment forecasts. Aggregates only, no individual learner records."
    },
    "admin": {
      "role": "admin",
      "label": "Admin",
      "product": "Education Tools MCP Admin",
      "productDisplayName": "Education Tools MCP Admin",
      "description": "Education: every tool, no business-rule limits. Used by admins and by the ungoverned agent in the Agent Showcase."
    }
  },
  "tools": [
    {
      "name": "searchStudents",
      "slot": "pii",
      "persona": "ops",
      "quotaPerMin": 20,
      "description": "Search learners by name, student ID or email prefix. Emails are masked.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Name, student ID or email prefix (at least 2 characters)"
          }
        },
        "required": [
          "query"
        ]
      },
      "area": "Students"
    },
    {
      "name": "getStudentProfile",
      "slot": "lookup",
      "persona": "ops",
      "quotaPerMin": 20,
      "description": "Get a learner's profile: programme, active enrolments, account balance and open support tickets.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "studentId": {
            "type": "string",
            "description": "Student ID, e.g. STU-3001"
          }
        },
        "required": [
          "studentId"
        ]
      },
      "area": "Students"
    },
    {
      "name": "listEnrolments",
      "slot": "lookup",
      "persona": "ops",
      "quotaPerMin": 20,
      "description": "List a learner's course enrolments with progress, status and next deadline.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "studentId": {
            "type": "string",
            "description": "Student ID, e.g. STU-3001"
          }
        },
        "required": [
          "studentId"
        ]
      },
      "area": "Enrolment"
    },
    {
      "name": "getCourseDetails",
      "slot": "lookup",
      "persona": "ops",
      "quotaPerMin": 20,
      "description": "Get a course: schedule, instructor, format, seats left and fee.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "courseId": {
            "type": "string",
            "description": "Course ID, e.g. DS-201"
          }
        },
        "required": [
          "courseId"
        ]
      },
      "area": "Courses"
    },
    {
      "name": "enrollInCourse",
      "slot": "write",
      "persona": "ops",
      "quotaPerMin": 10,
      "description": "Enrol a learner in a course if seats are available and prerequisites are met.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "studentId": {
            "type": "string",
            "description": "Student ID, e.g. STU-3001"
          },
          "courseId": {
            "type": "string",
            "description": "Course ID, e.g. CS-305"
          }
        },
        "required": [
          "studentId",
          "courseId"
        ]
      },
      "area": "Enrolment"
    },
    {
      "name": "dropCourse",
      "slot": "write",
      "persona": "ops",
      "quotaPerMin": 10,
      "description": "Withdraw a learner from a course enrolment.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "enrolmentId": {
            "type": "string",
            "description": "Enrolment ID, e.g. ENR-7003"
          },
          "reason": {
            "type": "string",
            "description": "Reason for withdrawing"
          }
        },
        "required": [
          "enrolmentId"
        ]
      },
      "area": "Enrolment"
    },
    {
      "name": "getAssignmentStatus",
      "slot": "lookup",
      "persona": "ops",
      "quotaPerMin": 20,
      "description": "List a learner's assignments in a course: due dates, submission status and grades so far.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "studentId": {
            "type": "string",
            "description": "Student ID, e.g. STU-3001"
          },
          "courseId": {
            "type": "string",
            "description": "Course ID, e.g. DS-201"
          }
        },
        "required": [
          "studentId",
          "courseId"
        ]
      },
      "area": "Assessments"
    },
    {
      "name": "grantDeadlineExtension",
      "slot": "write",
      "persona": "ops",
      "quotaPerMin": 10,
      "description": "Extend an assignment deadline by up to 14 days.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "submissionId": {
            "type": "string",
            "description": "Assignment submission ID, e.g. SUB-8801"
          },
          "days": {
            "type": "integer",
            "minimum": 1,
            "maximum": 14,
            "description": "Days to extend"
          },
          "reason": {
            "type": "string",
            "description": "Reason for the extension"
          }
        },
        "required": [
          "submissionId",
          "days"
        ]
      },
      "area": "Assessments"
    },
    {
      "name": "listInvoices",
      "slot": "lookup",
      "persona": "ops",
      "quotaPerMin": 20,
      "description": "List a learner's invoices and payments, including refunds and duplicate charges.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "studentId": {
            "type": "string",
            "description": "Student ID, e.g. STU-3001"
          }
        },
        "required": [
          "studentId"
        ]
      },
      "area": "Billing"
    },
    {
      "name": "issueTuitionRefund",
      "slot": "money",
      "persona": "ops",
      "quotaPerMin": 10,
      "description": "Refund all or part of a paid invoice to the learner. Refunds over the policy limit need finance approval.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "invoiceId": {
            "type": "string",
            "description": "Invoice ID from the invoice list, e.g. INV-5101"
          },
          "amount": {
            "type": "number",
            "description": "Amount to refund in USD"
          },
          "reason": {
            "type": "string",
            "description": "Reason for the refund"
          }
        },
        "required": [
          "invoiceId",
          "amount"
        ]
      },
      "area": "Billing"
    },
    {
      "name": "createSupportTicket",
      "slot": "write",
      "persona": "ops",
      "quotaPerMin": 10,
      "description": "Open a support ticket for a learner, e.g. a billing dispute or a technical problem.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "studentId": {
            "type": "string",
            "description": "Student ID, e.g. STU-3001"
          },
          "subject": {
            "type": "string",
            "description": "Short description of the issue"
          },
          "priority": {
            "type": "string",
            "description": "Low, Medium (default) or High",
            "enum": [
              "Low",
              "Medium",
              "High"
            ]
          }
        },
        "required": [
          "studentId",
          "subject"
        ]
      },
      "area": "Support"
    },
    {
      "name": "getCertificateStatus",
      "slot": "lookup",
      "persona": "ops",
      "quotaPerMin": 20,
      "description": "Check whether a learner's course certificate is issued, and what is left to earn it.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "studentId": {
            "type": "string",
            "description": "Student ID, e.g. STU-3001"
          },
          "courseId": {
            "type": "string",
            "description": "Course ID, e.g. DS-101"
          }
        },
        "required": [
          "studentId",
          "courseId"
        ]
      },
      "area": "Certificates"
    },
    {
      "name": "getApplicationStatus",
      "slot": "lookup",
      "persona": "ops",
      "quotaPerMin": 20,
      "description": "Get an admissions application: programme, stage, missing documents and decision date.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "applicationId": {
            "type": "string",
            "description": "Application ID, e.g. APP-9001"
          }
        },
        "required": [
          "applicationId"
        ]
      },
      "area": "Admissions"
    },
    {
      "name": "getEnrolmentTrends",
      "slot": "metrics",
      "persona": "insights",
      "quotaPerMin": 20,
      "description": "Monthly new enrolments, active learners and withdrawals by programme.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "months": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12,
            "description": "Months of history (default 6)"
          }
        }
      },
      "area": "Enrolment"
    },
    {
      "name": "getCourseCompletionRates",
      "slot": "metrics",
      "persona": "insights",
      "quotaPerMin": 20,
      "description": "Completion and pass rates by course, vs the previous period.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "period": {
            "type": "string",
            "description": "last_30d (default) or last_90d",
            "enum": [
              "last_30d",
              "last_90d"
            ]
          }
        }
      },
      "area": "Outcomes"
    },
    {
      "name": "getDropoutRiskSummary",
      "slot": "metrics",
      "persona": "insights",
      "quotaPerMin": 20,
      "description": "Learners at risk of dropping out by programme and risk driver. Aggregates only.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "programme": {
            "type": "string",
            "description": "Omit for all programmes",
            "enum": [
              "Data Science",
              "Cloud & DevOps",
              "UX Design",
              "Digital Marketing"
            ]
          }
        }
      },
      "area": "Retention"
    },
    {
      "name": "getAdmissionsFunnel",
      "slot": "metrics",
      "persona": "insights",
      "quotaPerMin": 20,
      "description": "Applications, offers, acceptances and enrolments for an intake term.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "term": {
            "type": "string",
            "description": "Intake term (default 2026-Fall)",
            "enum": [
              "2026-Spring",
              "2026-Fall"
            ]
          }
        }
      },
      "area": "Admissions"
    },
    {
      "name": "getLearnerEngagement",
      "slot": "metrics",
      "persona": "insights",
      "quotaPerMin": 20,
      "description": "Weekly active learners, video minutes, forum posts and mobile share.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "period": {
            "type": "string",
            "description": "last_30d (default) or last_90d",
            "enum": [
              "last_30d",
              "last_90d"
            ]
          }
        }
      },
      "area": "Engagement"
    },
    {
      "name": "getAssessmentIntegrityMetrics",
      "slot": "metrics",
      "persona": "insights",
      "quotaPerMin": 20,
      "description": "Plagiarism flags, AI-writing flags and proctoring incidents per 1,000 submissions.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "period": {
            "type": "string",
            "description": "last_30d (default) or last_90d",
            "enum": [
              "last_30d",
              "last_90d"
            ]
          }
        }
      },
      "area": "Assessments"
    },
    {
      "name": "getProgrammeProfitability",
      "slot": "confidential",
      "persona": "insights",
      "quotaPerMin": 20,
      "description": "Confidential: revenue, delivery cost, marketing cost and margin by programme.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "programme": {
            "type": "string",
            "description": "Omit for all programmes",
            "enum": [
              "Data Science",
              "Cloud & DevOps",
              "UX Design",
              "Digital Marketing"
            ]
          }
        }
      },
      "area": "Finance"
    },
    {
      "name": "runEnrolmentForecast",
      "slot": "forecast",
      "persona": "insights",
      "quotaPerMin": 2,
      "description": "Compute-heavy: forecast new enrolments per term by programme.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "horizonTerms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6,
            "description": "Terms to forecast (default 2)"
          }
        }
      },
      "area": "Enrolment"
    }
  ],
  "limit": {
    "tool": "issueTuitionRefund",
    "argument": "amount",
    "max": 50,
    "persona": "ops",
    "code": "REFUND_APPROVAL_LIMIT",
    "message": "Tuition refunds over $50 need finance approval."
  },
  "story": {
