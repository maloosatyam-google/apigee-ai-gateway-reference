# Optional overrides for the UI only. Normally everything comes from the repo-root .env
# (see ../.env.example), which the UI server, the Vite dev server and the live tests load.
#
# Values here win over the root .env for the UI.

# Default Apigee environment the UI opens on (prod | dev).
VITE_DEFAULT_ENV=prod
DEFAULT_ENV=prod

# Signed-in user when running locally without IAP (defaults to DEMO_ADMIN_EMAIL).
# SSO_USER_EMAIL=you@example.com
# VITE_SSO_USER_EMAIL=you@example.com

# Persona display identities in the UI.
# ADMIN_USER_EMAIL=admin.user@example.com
# SALES_AGENT_EMAIL=sales.agent@example.com
# LOANS_AGENT_EMAIL=loans.agent@example.com

# Live tests only: pin API keys instead of resolving them from Apigee / /api/me.
# VITE_ADMIN_API_KEY=
# VITE_SALES_API_KEY=
# VITE_LOANS_API_KEY=

# `npm run test:live` exercises PROD only (it sets TEST_ALLOW_PROD=1). It is not
# read-only: it burns token quota, debits the prepaid budget and seeds the semantic cache.

# Admin Console "Copy & open PR" target for rate-card fixes, e.g. your-org/your-repo (optional)
MODEL_WATCH_GITHUB_REPO=
# Bucket holding the daily model-watch report (defaults to THEME_BUCKET)
MODEL_WATCH_BUCKET=
