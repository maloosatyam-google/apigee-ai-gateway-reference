# =====================================================================================
# Apigee AI & Tools Gateway demo -- deployment configuration
#
#   cp .env.example .env      # .env is gitignored; never commit it
#
# Every script (scripts/lib/config.sh, scripts/lib/deploy_config.py) and the UI server
# (ui/server/deployConfig.js) read this one file. Proxy bundles carry __PLACEHOLDERS__
# that are filled from these values at package time (apigee/scripts/render_tokens.py).
# Only the "Required" block must be filled in; everything else has a derived default.
# =====================================================================================

# ---- Required ------------------------------------------------------------------------
# GCP project that hosts Apigee X, Vertex AI, Model Armor and the Cloud Run services.
GCP_PROJECT_ID=your-gcp-project
# Project NUMBER (gcloud projects describe $GCP_PROJECT_ID --format='value(projectNumber)').
# Looked up automatically if left empty and gcloud is available.
GCP_PROJECT_NUMBER=
# Region for Cloud Run, Model Armor and Vector Search (the Apigee runtime region is a good choice).
GCP_REGION=asia-southeast1
# Hostnames (no https://) of the environment groups your prod and dev Apigee environments
# are attached to. Use the same host twice if you only have one environment.
APIGEE_HOST_PROD=api.example.com
APIGEE_HOST_DEV=dev.api.example.com
# You: the demo owner. Owns the admin developer app, is a platform admin in the UI,
# and is the default signed-in user when running the UI locally without IAP.
DEMO_ADMIN_EMAIL=you@example.com

# ---- Apigee ---------------------------------------------------------------------------
# Apigee organization (default: GCP_PROJECT_ID).
APIGEE_ORG=
# Environment names used by the deploy scripts.
APIGEE_ENV_DEV=dev
APIGEE_ENV_PROD=prod
# Default environment for single-env scripts (deploy_proxy.sh, deploy_all.sh).
APIGEE_ENV=prod
# Apigee developer that owns the shared persona apps (Unified Sales App / Unified Loans App).
# Default: DEMO_ADMIN_EMAIL. Using a second identity keeps persona traffic separate in analytics.
PERSONA_APP_DEVELOPER=

# ---- Identities -----------------------------------------------------------------------
# Default signed-in user for local runs (default: DEMO_ADMIN_EMAIL). Behind IAP the real
# user comes from the IAP header.
SSO_USER_EMAIL=
# Service account the UI uses for the Apigee Management API (default shown).
# UI_MGMT_SA=apigee-ui-mgmt-sa@your-gcp-project.iam.gserviceaccount.com
# Runtime service account of the Apigee proxies (default shown).
# PROXY_SA=ai-client@your-gcp-project.iam.gserviceaccount.com

# ---- Cloud Run backends ---------------------------------------------------------------
# Defaults are the deterministic Cloud Run URLs https://<service>-<number>.<region>.run.app,
# so leave these empty unless your services use other URLs.
CUSTOMER_SERVICE_API_URL=
BUSINESS_INSIGHTS_API_URL=
INDUSTRY_APIS_URL=
SERVICENOW_MCP_URL=
AGENT_SHOWCASE_URL=
# UI Cloud Run service and image repository (defaults shown).
# UI_SERVICE=apigee-ai-gateway-ui
# ARTIFACT_REPO=asia-southeast1-docker.pkg.dev/your-gcp-project/cloud-run-source-deploy

# ---- Semantic cache (Vertex AI Vector Search) -----------------------------------------
# Written by `scripts/bootstrap.sh vectorsearch`. Set by hand to reuse an existing index.
VECTOR_SEARCH_ENDPOINT_HOST=
VECTOR_SEARCH_INDEX_ENDPOINT_ID=
VECTOR_SEARCH_INDEX_ID=

# ---- Theme library ----------------------------------------------------------------------
# GCS bucket for saved customer themes (default: <GCP_PROJECT_ID>-customer-themes).
THEME_BUCKET=

# ---- Daily pricing & model watch (services/model-watch) ------------------------------
# Deployed by `services/model-watch/deploy.sh` (Cloud Run job + Cloud Scheduler).
# Bucket for the watch reports (default: THEME_BUCKET).
MODEL_WATCH_BUCKET=
# owner/repo used by the Admin Console "Copy & open PR" button (empty = copy only).
MODEL_WATCH_GITHUB_REPO=
# Comma-separated non-chat models to watch too (e.g. text-embedding-005).
MODEL_WATCH_EXTRA_IN_USE=

# ---- Optional third-party credentials -------------------------------------------------
# Stored in the encrypted Apigee KVM `ai-gateway-creds` by `scripts/bootstrap.sh kvms`.
# Never referenced in code or proxy bundles. Leave empty to skip the external router.
TYPESAFE_API_KEY=

# ---- Local tooling ----------------------------------------------------------------------
# gcloud needs Python 3.10+; point it at one if your default python is older.
# CLOUDSDK_PYTHON=/usr/local/bin/python3.11
