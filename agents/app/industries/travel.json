{
  "id": "travel",
  "label": "Travel",
  "version": 1,
  "proxy": "travel-mcp",
  "basePath": "/travel/mcp",
  "currency": "USD",
  "personas": {
    "ops": {
      "role": "sales_agent",
      "label": "Guest Services",
      "app": "Unified Sales App",
      "product": "Travel Tools MCP - Guest Services",
      "productDisplayName": "Travel Tools MCP - Guest Services",
      "description": "Travel Guest Services: look up guests, reservations, room availability, folios and loyalty points; extend or cancel stays, change rooms, book amenities, post missing points, log complaints and credit folio charges (gateway limit $50). No property finance or revenue analytics."
    },
    "insights": {
      "role": "loans_agent",
      "label": "Revenue Mgmt",
      "app": "Unified Loans App",
      "product": "Travel Tools MCP - Revenue Mgmt",
      "productDisplayName": "Travel Tools MCP - Revenue Mgmt",
      "description": "Travel Revenue Management: occupancy, RevPAR, channel mix, cancellations, guest satisfaction and loyalty metrics, property margins and occupancy forecasts. Aggregates only, no individual guest records."
    },
    "admin": {
      "role": "admin",
      "label": "Digital Eng",
      "product": "Travel Tools MCP Admin",
      "productDisplayName": "Travel Tools MCP Admin",
      "description": "Travel: every tool, no business-rule limits. Used by admins and by the ungoverned agent in the Agent Showcase."
    }
  },
  "tools": [
    {
      "name": "searchHotelGuests",
      "slot": "pii",
      "persona": "ops",
      "quotaPerMin": 20,
      "description": "Search hotel guests by name, guest ID or email prefix. Emails are masked.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Name, guest ID or email prefix (at least 2 characters)"
          }
        },
        "required": [
          "query"
        ]
      },
      "area": "Guests"
    },
    {
      "name": "getGuestProfile",
      "slot": "lookup",
      "persona": "ops",
      "quotaPerMin": 20,
      "description": "Get a guest's profile: loyalty tier, current stay, preferences and open guest cases.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "guestId": {
            "type": "string",
            "description": "Guest ID, e.g. GST-4001"
          }
        },
        "required": [
          "guestId"
        ]
      },
      "area": "Guests"
    },
    {
      "name": "listGuestReservations",
      "slot": "lookup",
      "persona": "ops",
      "quotaPerMin": 20,
      "description": "List a guest's hotel reservations: property, dates, room type, rate and status.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "guestId": {
            "type": "string",
            "description": "Guest ID, e.g. GST-4001"
          }
        },
        "required": [
          "guestId"
        ]
      },
      "area": "Reservations"
    },
    {
      "name": "checkRoomAvailability",
      "slot": "lookup",
      "persona": "ops",
      "quotaPerMin": 20,
      "description": "Check rooms left and nightly rates at a property for a check-in date.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "propertyId": {
            "type": "string",
            "description": "Property ID, e.g. HTL-DT"
          },
          "checkIn": {
            "type": "string",
            "description": "Check-in date YYYY-MM-DD (default today)"
          },
          "nights": {
            "type": "integer",
            "minimum": 1,
            "maximum": 14,
            "description": "Nights (default 1)"
          }
        },
        "required": [
          "propertyId"
        ]
      },
      "area": "Rooms"
    },
    {
      "name": "extendHotelStay",
      "slot": "write",
      "persona": "ops",
      "quotaPerMin": 10,
      "description": "Add nights to a reservation if the room type is still available.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "reservationId": {
            "type": "string",
            "description": "Reservation ID, e.g. RSV-2201"
          },
          "nights": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7,
            "description": "Nights to add"
          }
        },
        "required": [
          "reservationId",
          "nights"
        ]
      },
      "area": "Reservations"
    },
    {
      "name": "cancelHotelReservation",
      "slot": "write",
      "persona": "ops",
      "quotaPerMin": 10,
      "description": "Cancel an upcoming reservation and report any cancellation fee under the rate rules.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "reservationId": {
            "type": "string",
            "description": "Reservation ID, e.g. RSV-2210"
          },
          "reason": {
            "type": "string",
            "description": "Reason for cancelling"
          }
        },
        "required": [
          "reservationId"
        ]
      },
      "area": "Reservations"
    },
    {
      "name": "requestRoomChange",
      "slot": "write",
      "persona": "ops",
      "quotaPerMin": 10,
      "description": "Move an in-house guest to another room, optionally of a different room type, at no extra charge.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "reservationId": {
            "type": "string",
            "description": "Reservation ID, e.g. RSV-2201"
          },
          "reason": {
            "type": "string",
            "description": "Why the guest is moving, e.g. air conditioning fault"
          },
          "roomType": {
            "type": "string",
            "description": "Target room type (default: same type)",
            "enum": [
              "Queen Standard",
              "King Deluxe",
              "Junior Suite"
            ]
          }
        },
        "required": [
          "reservationId",
          "reason"
        ]
      },
      "area": "Stays"
    },
    {
      "name": "getGuestFolio",
      "slot": "lookup",
      "persona": "ops",
      "quotaPerMin": 20,
      "description": "Get the folio (bill) for a stay: every charge, credits already applied and the balance.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "reservationId": {
            "type": "string",
            "description": "Reservation ID, e.g. RSV-2201"
          }
        },
        "required": [
          "reservationId"
        ]
      },
      "area": "Folio"
    },
    {
      "name": "issueFolioCredit",
      "slot": "money",
      "persona": "ops",
      "quotaPerMin": 10,
      "description": "Credit all or part of a folio charge back to the guest. Credits over the policy limit need front-office manager approval.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "chargeId": {
            "type": "string",
            "description": "Charge ID from the folio, e.g. CHG-7101"
          },
          "amount": {
            "type": "number",
            "description": "Amount to credit in USD"
          },
          "reason": {
            "type": "string",
            "description": "Reason for the credit"
          }
        },
        "required": [
          "chargeId",
          "amount"
        ]
      },
      "area": "Folio"
    },
    {
      "name": "getLoyaltyBalance",
      "slot": "lookup",
      "persona": "ops",
      "quotaPerMin": 20,
      "description": "Get a guest's loyalty tier, points balance, nights this year and recent point postings.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "guestId": {
            "type": "string",
            "description": "Guest ID, e.g. GST-4001"
          }
        },
        "required": [
          "guestId"
        ]
      },
      "area": "Loyalty"
    },
    {
      "name": "creditMissingStayPoints",
      "slot": "write",
      "persona": "ops",
      "quotaPerMin": 10,
      "description": "Post loyalty points for a completed stay that did not earn them.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "reservationId": {
            "type": "string",
            "description": "Completed reservation ID, e.g. RSV-2150"
          }
        },
        "required": [
          "reservationId"
        ]
      },
      "area": "Loyalty"
    },
    {
      "name": "bookHotelAmenity",
      "slot": "write",
      "persona": "ops",
      "quotaPerMin": 10,
      "description": "Book an amenity for an in-house or upcoming stay: spa, dining, late checkout or parking.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "reservationId": {
            "type": "string",
            "description": "Reservation ID, e.g. RSV-2201"
          },
          "amenity": {
            "type": "string",
            "description": "Amenity to book",
            "enum": [
              "Spa treatment",
              "Dinner reservation",
              "Late checkout",
              "Valet parking"
            ]
          },
          "date": {
            "type": "string",
            "description": "Date YYYY-MM-DD (default today)"
          }
        },
        "required": [
          "reservationId",
          "amenity"
        ]
      },
      "area": "Amenities"
    },
    {
      "name": "logGuestComplaint",
      "slot": "write",
      "persona": "ops",
      "quotaPerMin": 10,
      "description": "Log a guest complaint or request for follow-up by the duty manager.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "reservationId": {
            "type": "string",
            "description": "Reservation ID, e.g. RSV-2201"
          },
          "subject": {
            "type": "string",
            "description": "Short description of the issue"
          },
          "priority": {
            "type": "string",
            "description": "Low, Medium (default) or High",
            "enum": [
              "Low",
              "Medium",
              "High"
            ]
          }
        },
        "required": [
          "reservationId",
          "subject"
        ]
      },
      "area": "Guest Relations"
    },
    {
      "name": "getOccupancyTrends",
      "slot": "metrics",
      "persona": "insights",
      "quotaPerMin": 20,
      "description": "Monthly occupancy, ADR (average daily rate) and RevPAR across the portfolio.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "months": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12,
            "description": "Months of history (default 6)"
          }
        }
      },
      "area": "Occupancy"
    },
    {
      "name": "getRevparByProperty",
      "slot": "metrics",
      "persona": "insights",
      "quotaPerMin": 20,
      "description": "RevPAR, ADR and occupancy by property vs the previous period.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "period": {
            "type": "string",
            "description": "last_30d (default) or last_90d",
            "enum": [
              "last_30d",
              "last_90d"
            ]
          }
        }
      },
      "area": "Revenue"
    },
    {
      "name": "getBookingChannelMix",
      "slot": "metrics",
      "persona": "insights",
      "quotaPerMin": 20,
      "description": "Share of room nights and commission cost by booking channel.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "period": {
            "type": "string",
            "description": "last_30d (default) or last_90d",
            "enum": [
              "last_30d",
              "last_90d"
            ]
          }
        }
      },
      "area": "Distribution"
    },
    {
      "name": "getCancellationRates",
      "slot": "metrics",
      "persona": "insights",
      "quotaPerMin": 20,
      "description": "Cancellation and no-show rates by property and rate type. Aggregates only.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "property": {
            "type": "string",
            "description": "Omit for all properties",
            "enum": [
              "Harbor Downtown",
              "Seaside Resort",
              "Ridge Mountain Lodge",
              "Lakeside Conference Hotel"
            ]
          }
        }
      },
      "area": "Reservations"
    },
    {
      "name": "getGuestSatisfactionIndex",
      "slot": "metrics",
      "persona": "insights",
      "quotaPerMin": 20,
      "description": "Guest satisfaction score, net promoter score and top complaint themes by property.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "period": {
            "type": "string",
            "description": "last_30d (default) or last_90d",
            "enum": [
              "last_30d",
              "last_90d"
            ]
          }
        }
      },
      "area": "Guest Experience"
    },
    {
      "name": "getLoyaltyTierMetrics",
      "slot": "metrics",
      "persona": "insights",
      "quotaPerMin": 20,
      "description": "Members, share of room nights, repeat-stay rate and points liability by loyalty tier.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "area": "Loyalty"
    },
    {
      "name": "getPropertyMargins",
      "slot": "confidential",
      "persona": "insights",
      "quotaPerMin": 20,
      "description": "Confidential: room revenue, F&B revenue, operating cost and GOP margin by property.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "property": {
            "type": "string",
            "description": "Omit for all properties",
            "enum": [
              "Harbor Downtown",
              "Seaside Resort",
              "Ridge Mountain Lodge",
              "Lakeside Conference Hotel"
            ]
          }
        }
      },
      "area": "Finance"
    },
    {
      "name": "runOccupancyForecast",
      "slot": "forecast",
      "persona": "insights",
      "quotaPerMin": 2,
      "description": "Compute-heavy: forecast occupancy and ADR per month by property.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "horizonMonths": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12,
            "description": "Months to forecast (default 3)"
          }
        }
      },
      "area": "Occupancy"
    }
  ],
  "limit": {
    "tool": "issueFolioCredit",
    "argument": "amount",
    "max": 50,
    "persona": "ops",
    "code": "FOLIO_CREDIT_LIMIT",
    "message": "Folio credits over $50 need front-office manager approval."
  },
  "story": {
    "customerId": "GST-4001",
    "customerName": "Jamie Collins",
    "reservationId": "RSV-2201",
    "propertyId": "HTL-DT",
    "smallFeeId": "CHG-7101",
    "smallFeeAmount": 30,
    "largeFeeId": "CHG-7102",
    "largeFeeAmount": 120,
    "summary": "Jamie Collins (GST-4001), a Gold loyalty member, is mid-stay at Harbor Downtown (RSV-2201): the air conditioning in room 1412 failed (case GC-9001), the $120 room upgrade fee was posted twice (CHG-7102) and the August stay (RSV-2150) never earned its points. Crediting the $30 minibar charge (CHG-7101) is within policy; crediting the $120 duplicate needs front-office manager approval."
  },
