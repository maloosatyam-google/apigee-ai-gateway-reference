# Agent Showcase service. No Apigee keys live here: the UI server forwards the
# user's identity token and persona keys on every request.
ENVIRONMENT=development
GATEWAY_HOST=https://api.example.com
# Baseline ("without AI governance") agent: BASELINE_MODEL through the llm-passthrough-v1
# proxy (records traffic, no governance). GCP_PROJECT/VERTEX_LOCATION only matter for the
# optional direct-Vertex mode (llm="vertex" in profiles.py), which uses this service's ADC.
GCP_PROJECT=your-gcp-project
VERTEX_LOCATION=global
BASELINE_MODEL=gemini-3.1-pro-preview
MAX_LLM_CALLS=12
